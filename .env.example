# Copy to .env and fill in. .env is gitignored.

# --- n8n ---------------------------------------------------------------------
# Encrypts the credentials n8n stores. Generate once and keep it: losing it means
# re-entering every credential.   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

TZ=Indian/Antananarivo

# --- Workflow settings (not secrets) -----------------------------------------
# Where the portfolio's Worker serves the lead queue (see docs/queue.md).
LEADS_API_BASE=https://imhery.dev

# Gemini models that qualify leads, preferred first, comma-separated. When one fails —
# free models answer 503 "high demand" for minutes at a time — the next one gets the
# lead; the workflow tries up to 4. See which ones your key can use, and get a line to
# paste here, with:   npm run check -- --models
# Free tier: https://aistudio.google.com/apikey
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash
# Base URL of the Gemini API. Only changed by the test harness, to point at a mock.
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Notion database that receives the leads (the 32-character id in its URL).
NOTION_DATABASE_ID=
# Base URL of the Notion API. Only changed by the test harness.
NOTION_API_BASE=https://api.notion.com

# Chat that receives the Telegram notifications: your user id, from @userinfobot.
TELEGRAM_CHAT_ID=
# Base URL of the Telegram Bot API. Only changed by the test harness.
TELEGRAM_API_BASE=https://api.telegram.org

# Secrets — the queue's token, Gemini API key, Notion integration token, Telegram
# bot token — are NOT set here. They are entered once as n8n
# credentials; see the README.
